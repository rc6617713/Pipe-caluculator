        # =================================================
        # OPTION 4: PRESSURE DROP
        # =================================================

        elif choice == "4":

            print("\n--- PRESSURE DROP ---")

            rho = float(
                input("Enter fluid density (kg/m^3): ")
            )

            f = float(
                input("Enter Darcy friction factor: ")
            )

            length = float(
                input("Enter pipe length (m): ")
            )

            diameter = float(
                input("Enter pipe diameter (m): ")
            )

            velocity = float(
                input("Enter fluid velocity (m/s): ")
            )

            # Formula 7
            hf = head_loss(
                f,
                length,
                diameter,
                velocity
            )

            # Formula 8
            delta_p = pressure_drop(
                rho,
                hf
            )

            # Formula 10
            delta_p_kpa = pascal_to_kpa(
                delta_p
            )

            print("\nHead Loss =", round(hf, 4), "m")
            print("Pressure Drop =", round(delta_p, 2), "Pa")
            print("Pressure Drop =", round(delta_p_kpa, 4), "kPa")


        # =================================================
        # OPTION 5: CALCULATE ALL
        # =================================================

        elif choice == "5":

            calculate_all()


        # =================================================
        # OPTION 6: EXIT
        # =================================================

        elif choice == "6":

            print("\nThank you for using the Pipe Flow Calculator!")
            break


        # =================================================
        # INVALID CHOICE
        # =================================================

        else:

            print("\nInvalid choice!")
            print("Please enter a number from 1 to 6.")


# =========================================================
# START PROGRAM
# =========================================================

if __name__ == "__main__":
    main()
