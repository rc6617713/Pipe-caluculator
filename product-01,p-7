                velocity,
                diameter,
                viscosity
            )

            print("\nReynolds Number =", round(Re, 2))
            print("Flow Regime =", flow_regime(Re))


        # =================================================
        # OPTION 2: FRICTION FACTOR
        # =================================================

        elif choice == "2":

            print("\n--- DARCY FRICTION FACTOR ---")

